# Local development credentials. Copy to `.env` and adjust if needed.
# `.env` is gitignored - never commit real secrets.
# All passwords below are clearly marked dev-only and unsafe for any other use.

# === Images =================================================================
# `docker compose up` pulls the images published to ghcr.io/ceendi/deepfake-detector when they
# are not present locally; `docker compose pull` updates them, `up --build` builds this checkout.
# latest = last green main. Pin a published sha-<7-char commit> tag for a reproducible deploy.
DEEPFAKE_IMAGE_TAG=latest

# === Compose profiles =======================================================
# Profiles a plain `docker compose up -d` starts: the whole application. Add `monitoring` for
# Grafana, or drop `ml` for a lighter backend. An explicit --profile on the command line wins.
COMPOSE_PROFILES=core,auth,ml

# === PostgreSQL =============================================================
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=changeme_dev
POSTGRES_DB=deepfake
# POSTGRES_PORT=5432
# Database-per-service: the file-service gets its own DB + least-privilege user in the
# same Postgres container (created by infra/postgres/init on first/empty start).
# Password is interpolated into a SQL string literal — keep it apostrophe-free.
FILE_SERVICE_DB_NAME=fileservice
FILE_SERVICE_DB_USER=fileservice
FILE_SERVICE_DB_PASSWORD=changeme_dev_fsdb

# Java backend failure budgets (duration syntax: 250ms, 2s).
REDIS_CONNECT_TIMEOUT=250ms
REDIS_COMMAND_TIMEOUT=250ms
REDIS_DEGRADED_BYPASS=2s
# Comma-separated frontend origins accepted by gateway CORS.
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
GATEWAY_REDIS_LIMITER_BUDGET=750ms
GATEWAY_REDIS_DEGRADED_BYPASS=2s

# Outbox dispatch and stuck recovery share this orchestrator scheduler pool.
SCHEDULER_POOL_SIZE=2

# === Redis ==================================================================
REDIS_PASSWORD=changeme_dev
# REDIS_PORT=6379

# === RabbitMQ ===============================================================
# Administrator for manual operations only (management UI, rabbitmqctl).
RABBITMQ_USER=deepfake
RABBITMQ_PASSWORD=changeme_dev
# Least-privilege application users created by rabbitmq-init (names are fixed:
# `orchestrator`, `detector`). Re-running `docker compose up` with every used profile
# (including `ml`) applies a changed password.
RABBITMQ_ORCHESTRATOR_PASSWORD=changeme_dev_orch
RABBITMQ_DETECTOR_PASSWORD=changeme_dev_det
# RABBITMQ_AMQP_PORT=5672
# RABBITMQ_UI_PORT=15672
# Stable node identity; keep the original container hostname when adopting an existing volume.
# RABBITMQ_HOSTNAME=rabbitmq

# === Object Storage (SeaweedFS, S3-compatible) ==============================
# Names are vendor-neutral (S3_*) so swapping SeaweedFS for AWS S3, R2, or
# another backend later requires no app-side changes.
#
# Four identities, each scoped to specific buckets via infra/seaweedfs/s3.json:
#   - admin        (Admin)                                     - bucket creation only
#   - file-service (RW: deepfake-uploads)                      - upload pipeline
#   - detector     (R: deepfake-uploads, RW: analysis-artifacts) - ML services
#   - orchestrator (RW/List: analysis-artifacts)              - Write enables cleanup deletes (also permits puts)
S3_ADMIN_KEY=df-admin
S3_ADMIN_SECRET=changeme_dev_admin
S3_FILE_SERVICE_KEY=fs-key
S3_FILE_SERVICE_SECRET=changeme_dev_fs
S3_DETECTOR_KEY=det-key
S3_DETECTOR_SECRET=changeme_dev_det
S3_ORCHESTRATOR_KEY=orch-key
S3_ORCHESTRATOR_SECRET=changeme_dev_orch
# S3_PORT=8333
# Host baked into presigned URLs (file-service). Must be reachable from the browser; the internal
# seaweedfs:8333 is not resolvable outside the docker network. Dev: localhost:8333.
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333

# === Keycloak ===============================================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_dev
# Dedicated Postgres for Keycloak (service `keycloak-db`, profile `auth`).
# Without persistent DB, dev users would vanish on every `compose down` —
# Postgres from day one keeps them across restarts.
KEYCLOAK_DB_PASSWORD=changeme_dev_kcdb
# KEYCLOAK_PORT=8180
# Default import contains no test users or load-test client. Opt in locally with:
# KEYCLOAK_REALM_CONFIG=dev/realm-export.json
# Secret of the DEV-only `deepfake-loadtest` client (service account, USER role) — JMeter gets a
# token via client_credentials for the D4 load test. Not used by the app or the browser SPA.
LOADTEST_CLIENT_SECRET=changeme_dev_loadtest

# === Frontend (service `frontend`, profile `auth`) ==========================
# Web UI at http://localhost:4173. The realm's deepfake-web client allows 4173 and 5173
# (`npm run dev`); add another port to its redirect URIs and web origins before using it.
# The container passes the Keycloak URL (from KEYCLOAK_PORT) to the browser at start.
# FRONTEND_PORT=4173

# === Application config =====================================================
# Single, stable issuer URL. KC_HOSTNAME forces every token to carry this exact
# `iss`, so backend services validate against it (and the frontend redirects here).
# Dockerized backends fetch the signing keys over the docker network instead
# (JWK_SET_URI, set in docker-compose.yml — not a secret, so it lives only there).
# This value is the default backends use when run from the IDE.
JWT_ISSUER_URI=http://localhost:8180/realms/deepfake
# Comma-separated clients accepted by file-service and orchestrator (azp, or aud when azp is absent).
JWT_ALLOWED_CLIENTS=deepfake-web,deepfake-loadtest

# === Observability (OpenTelemetry tracing) ==================================
# Tracer is always on (traceId/spanId in logs). Only OTLP *export* is gated:
# keep it false for core-only dev, else the exporter spams a dead endpoint.
# Flip to true when running the `monitoring` profile (Tempo present) to see traces in Grafana.
# NOTE: containers read this only at start — after changing it, recreate the services
# (`docker compose up -d --force-recreate orchestrator gateway file-service video-detector audio-detector`),
# a plain restart keeps the stale value.
OTEL_TRACING_EXPORT_ENABLED=false
OTEL_OTLP_ENDPOINT=http://tempo:4318/v1/traces

# === Observability stack (profile: monitoring) ==============================
# Alloy receives ALLOY_COMPOSE_PROJECT from the resolved COMPOSE_PROJECT_NAME automatically.
# Grafana admin login (user: admin). Dev-only. UI at http://localhost:3000.
GF_SECURITY_ADMIN_PASSWORD=admin
# Host ports (all bound to 127.0.0.1). Uncomment to override.
# PROMETHEUS_PORT=9090
# LOKI_PORT=3100
# TEMPO_PORT=3200
# GRAFANA_PORT=3000
# ALLOY_PORT=12345

# File-service ffprobe retained stdout cap in bytes (positive integer; default 64 KiB).
MEDIA_PROBE_MAX_OUTPUT_BYTES=65536
# Shared upload/audio/video guard: maximum media duration in seconds (finite, positive; 30 min).
MEDIA_MAX_DURATION_SECONDS=1800
# Upload safety: pixels (4K, also the video detector guard), per-owner bytes (5 GiB), unused lifetime and per-replica admission.
MEDIA_MAX_PIXELS=8294400
STORAGE_QUOTA_BYTES=5368709120
UPLOAD_UNUSED_RETENTION=7d
UPLOAD_MAX_CONCURRENT=4
# Per jwt.sub and per replica; independent of the global replica limit above.
UPLOAD_MAX_CONCURRENT_PER_USER=2
UPLOAD_SPOOL_DIRECTORY=/tmp/deepfake-uploads
# Detectors: a task running longer than this (seconds) restarts the worker; RabbitMQ redelivers it.
DETECTOR_TASK_HARD_LIMIT_SECONDS=3600
# Inference threads per detector container (ONNX Runtime and torch; video includes InsightFace).
# Invalid settings stop startup before loading models. Video requires >=1; audio allows 0.
# Use at most the CPUs the container really gets: two detectors that each take every host core run slower than one
# Audio 0 = library default (all host cores).
# AUDIO_ONNX_INTRA_THREADS=6
# VIDEO_ONNX_INTRA_THREADS=4

# === Backpressure (orchestrator) ============================================
# Max concurrent in-flight analyses before POST /api/analysis returns 429.
# Lower it (e.g. 2) to exercise backpressure with the fast dummy detectors.
BACKPRESSURE_MAX_INFLIGHT=20
# Per authenticated user; FULL counts as one analysis in both limits.
BACKPRESSURE_MAX_INFLIGHT_PER_USER=3
BACKPRESSURE_RETRY_AFTER_SECONDS=5
FILE_SERVICE_BASE_URL=http://file-service:8081
FILE_SERVICE_LOOKUP_TIMEOUT=2s

# Transactional dispatch: disabling stops the publisher, not durable creation.
RELIABILITY_OUTBOX_ENABLED=true
RELIABILITY_OUTBOX_POLL_INTERVAL_MS=1000
RELIABILITY_OUTBOX_CONFIRM_TIMEOUT_MS=5000
RELIABILITY_OUTBOX_RETRY_SECONDS=5
RELIABILITY_OUTBOX_DISPATCH_TIMEOUT_SECONDS=120
RELIABILITY_OUTBOX_BATCH_SIZE=20

# === Load test (D4 — file-service replication) ==============================
# Number of file-service replicas. Default 1; set 2 for the D4 comparison run.
# Count-only scaling preserves existing replicas: FILE_SERVICE_REPLICAS=2 docker compose --profile core --profile auth up -d --no-recreate --scale file-service=2 file-service
FILE_SERVICE_REPLICAS=1
# Gateway upload rate-limit per user: 1 token/s, 60 capacity, 12 tokens/upload = 5/min, burst 5.
# Isolated D4 test: replenish/burst ~10000 and requested-tokens=1 (see load-tests/jmeter/README.md).
# UPLOAD_RL_REPLENISH=1
# UPLOAD_RL_BURST=60
# UPLOAD_RL_REQUESTED_TOKENS=12

# Orchestrator generated-artifact reads (independent of file-service upload budgets).
ARTIFACT_MAX_BYTES=8388608
ARTIFACT_STORAGE_CALL_TIMEOUT=5s
ARTIFACT_STORAGE_ATTEMPT_TIMEOUT=2s
ARTIFACT_STORAGE_CONNECT_TIMEOUT=500ms

# Durable generated-artifact cleanup (dedicated scheduler; source uploads excluded).
ARTIFACT_CLEANUP_ENABLED=true
ARTIFACT_CLEANUP_POLL_INTERVAL_MS=1000
ARTIFACT_CLEANUP_SCAN_INTERVAL_MS=60000
ARTIFACT_CLEANUP_BATCH_SIZE=10
ARTIFACT_CLEANUP_PAGE_SIZE=1000
ARTIFACT_CLEANUP_ORPHAN_AGE=24h
ARTIFACT_CLEANUP_LEASE=30s
ARTIFACT_CLEANUP_RETRY=5s
ARTIFACT_CLEANUP_MAX_RETRY=1h

# Backend recovery publishing: delayed resume doubles to a cap while originals remain durable.
AMQP_CHANNEL_RPC_TIMEOUT=1s
AMQP_RECOVERY_CONFIRM_TIMEOUT=2s
AMQP_RECOVERY_DELAY=5s
AMQP_MAX_RECOVERY_DELAY=60s

# SSE admission and isolated writers; slow-write is observation, not a socket deadline.
SSE_GLOBAL_CONNECTIONS=128
SSE_USER_CONNECTIONS=4
SSE_ANALYSIS_CONNECTIONS=4
SSE_LIFETIME=10m
SSE_HEARTBEAT=15s
SSE_SLOW_WRITE=5s

# Recovery allowances: dispatched PENDING queue wait and total active analysis age.
RELIABILITY_STUCK_JOB_THRESHOLD_SECONDS=600
RELIABILITY_STUCK_JOB_SCAN_INTERVAL_MS=300000
# Optional: default follows the idle threshold above.
# RELIABILITY_STUCK_JOB_INITIAL_DELAY=600s
RELIABILITY_IDEMPOTENCY_TTL_SECONDS=900
RELIABILITY_STUCK_JOB_QUEUE_TIMEOUT_SECONDS=1800
RELIABILITY_STUCK_JOB_MAX_AGE_SECONDS=7200
