# Relative API paths use 'self'; absolute URLs contribute only their origin to CSP.
map "${API_BASE_URL}" $api_csp_source {
    default "";
    "~^(https?://[^/]+)" $1;
}

map "${KEYCLOAK_URL}" $keycloak_csp_source {
    default "";
    "~^(https?://[^/]+)" $1;
}

# A path in the presigned-URL endpoint would limit media-src to that exact path.
map "${MEDIA_URL}" $media_csp_source {
    default "";
    "~^(https?://[^/]+)" $1;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-__THEME_SCRIPT_HASH__'; style-src 'self' 'unsafe-inline'; connect-src 'self' $api_csp_source $keycloak_csp_source; frame-src 'self' $keycloak_csp_source; img-src 'self' blob: data:; media-src 'self' blob: $media_csp_source; form-action 'self';" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime settings for src/config/env.ts, rendered from the container env at start, so a
    # published image is not tied to the Keycloak address it was built with.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-__THEME_SCRIPT_HASH__'; style-src 'self' 'unsafe-inline'; connect-src 'self' $api_csp_source $keycloak_csp_source; frame-src 'self' $keycloak_csp_source; img-src 'self' blob: data:; media-src 'self' blob: $media_csp_source; form-action 'self';" always;
        return 200 'window.__APP_CONFIG__ = {"apiBaseUrl": "${API_BASE_URL}", "keycloakUrl": "${KEYCLOAK_URL}", "keycloakRealm": "${KEYCLOAK_REALM}", "keycloakClientId": "${KEYCLOAK_CLIENT_ID}"};\n';
    }

    # Resolve the gateway per request, so nginx starts (and serves the SPA) before it exists.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        set $api_upstream ${GATEWAY_URL};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Analysis progress is SSE: stream events instead of buffering them.
        proxy_buffering off;
        proxy_read_timeout 1h;
        # Same cap as file-service; stream uploads straight to the gateway.
        client_max_body_size 501m;
        proxy_request_buffering off;
    }

    # Keycloak redirects its hidden frame here to notify the same-origin parent.
    location = /silent-check-sso.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; frame-ancestors 'self'; base-uri 'none'; object-src 'none';" always;
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-__THEME_SCRIPT_HASH__'; style-src 'self' 'unsafe-inline'; connect-src 'self' $api_csp_source $keycloak_csp_source; frame-src 'self' $keycloak_csp_source; img-src 'self' blob: data:; media-src 'self' blob: $media_csp_source; form-action 'self';" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-__THEME_SCRIPT_HASH__'; style-src 'self' 'unsafe-inline'; connect-src 'self' $api_csp_source $keycloak_csp_source; frame-src 'self' $keycloak_csp_source; img-src 'self' blob: data:; media-src 'self' blob: $media_csp_source; form-action 'self';" always;
        try_files $uri /index.html;
    }
}
